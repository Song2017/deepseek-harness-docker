# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# ── 认证（重要）──────────────────────────────────────────────
# PROXY_PASSWORD 留空 = 每次启动生成随机密码，用 `docker compose logs` 查看
# 要固定密码就填在这里（注意：.env 含明文密码，勿提交到 git）
PROXY_USERNAME=admin
PROXY_PASSWORD=

# ── 端口 ─────────────────────────────────────────────────────
# 宿主机暴露端口
HOST_PORT=3080
# 容器内代理端口（对外）
PROXY_PORT=3080
# 容器内 DSH 端口（仅回环，一般不用改）
DSH_PORT=3079

# ── 构建参数（仅 docker compose build 时生效）─────────────────
# 固定 DSH 版本以获得可复现构建，例如 0.1.2；默认 next
DSH_VERSION=next
# 开发工具变体：none / devtools-min / devtools / test / admin
DEV_TOOLS=none
